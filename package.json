{
  "name": "cateiru-com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check": "biome check",
    "check:fix": "biome check --fix",
    "vrt": "playwright test --config=playwright.vrt.config.ts",
    "vrt:reg": "reg-suit run",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@fontsource/line-seed-jp": "^5.2.2",
    "@vinext/cloudflare": "^1.3.2",
    "classnames": "^2.5.1",
    "next": "^16.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.2"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@12.4.1",
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@opennextjs/cloudflare": "latest",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cssnano": "^9.0.0",
    "postcss": "^8.5.0",
    "postcss-preset-env": "^11.2.0",
    "reg-keygen-git-hash-plugin": "^0.14.5",
    "reg-publish-s3-plugin": "^0.14.4",
    "reg-suit": "^0.14.5",
    "typescript": "^7.0.0",
    "vite": "^8.3.5",
    "vite-css-modules": "^1.16.1",
    "wrangler": "^4.156.2"
  },
  "type": "module"
}
