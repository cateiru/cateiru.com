{
  "name": "cateiru-com",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    "enable_weak_ref"
  ],
  "preview_urls": true,
  // assets は vite build 時に生成される dist/server/wrangler.json で上書きされる
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "cateiru.com",
      "zone_name": "cateiru.com",
      "custom_domain": true
    }
  ]
}
